{
  "info": {
    "name": "Expense Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "user_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "expense_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Signup (duplicate — expect 409)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('user_token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('admin_token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tracker.com\",\n  \"password\": \"adminpass123\"\n}"
            }
          }
        },
        {
          "name": "Login (wrong password — expect 401)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Expenses (User)",
      "item": [
        {
          "name": "Create Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('expense_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/expenses",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Weekly Groceries\",\n  \"amount\": 75.50,\n  \"category\": \"Groceries\",\n  \"date\": \"2026-05-20\"\n}"
            }
          }
        },
        {
          "name": "Create Expense (invalid category — expect 400)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/expenses",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test\",\n  \"amount\": 10,\n  \"category\": \"Food\",\n  \"date\": \"2026-05-20\"\n}"
            }
          }
        },
        {
          "name": "Get Expenses",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/expenses",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Get Expenses — filter past_week",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/expenses?filter=past_week",
              "query": [{ "key": "filter", "value": "past_week" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Get Expenses — filter past_month",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/expenses?filter=past_month",
              "query": [{ "key": "filter", "value": "past_month" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Get Expenses — filter last_3_months",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/expenses?filter=last_3_months",
              "query": [{ "key": "filter", "value": "last_3_months" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Get Expenses — filter custom",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/expenses?filter=custom&start_date=2026-05-01&end_date=2026-05-31",
              "query": [
                { "key": "filter", "value": "custom" },
                { "key": "start_date", "value": "2026-05-01" },
                { "key": "end_date", "value": "2026-05-31" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/expenses/{{expense_id}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Monthly Groceries\",\n  \"amount\": 120,\n  \"category\": \"Groceries\",\n  \"date\": \"2026-05-20\"\n}"
            }
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/expenses/{{expense_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        },
        {
          "name": "Get Expenses (no token — expect 401)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/expenses"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Get All Expenses",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/admin/expenses",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "Delete Any Expense",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/admin/expenses/{{expense_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }]
          }
        },
        {
          "name": "User tries admin route (expect 403)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }]
          }
        }
      ]
    }
  ]
}
